  "devDependencies": {
    "@ai-sdk/provider": "^3.0.0",
    "@opencode-ai/plugin": "1.18.18",
    "@opencode-ai/sdk": "1.18.18",
    "@types/bun": "latest",
    "opencode-ai": "1.18.18",
    "typescript": "^5.8.0"
  },
  "dependencies": {
    "@ai-sdk/openai": "^3.0.67",
    "zod": "^3.25.0-beta.20250519T094321"
