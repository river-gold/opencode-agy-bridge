{
  "name": "opencode-agy-plugin",
  "version": "0.3.1",
  "type": "module",
  "main": "./dist/index.js",
  "license": "MIT",
  "description": "OpenCode plugin + provider that routes LLM prompts to agy (Google Antigravity CLI)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/river-gold/opencode-agy-plugin.git"
  },
  "homepage": "https://github.com/river-gold/opencode-agy-plugin",
  "bugs": {
    "url": "https://github.com/river-gold/opencode-agy-plugin/issues"
  },
  "publishConfig": {
