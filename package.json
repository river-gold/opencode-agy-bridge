    "registry": "https://registry.npmjs.org/"
  },
  "exports": {
    ".": "./dist/index.js",
    "./provider": "./dist/provider.js",
    "./plugin": "./dist/plugin.js"
  },
  "files": [
    "dist",
    "plugin.js",
    "provider.js"
  ],
  "scripts": {
